# ── 后端讯飞 API ──
IFLYTEK_API_KEY=<api-key>:<api-secret>
IFLYTEK_MODEL=astron-code-latest

# ── ATA100 薪酬域共享 cookie 密钥（必须与 ATA100 中心一致）──
ATA_MEMBER_SESSION_PASSWORD=<must-match-ata100-center>
ATA_COOKIE_SECURE=false

# ── ATA100 中心地址（后端 VIP 校验 / 前端跳登录）──
ATA_CENTER_BASE_URL=http://localhost:4004
VITE_CENTER_URL=http://localhost:4004/

# ── API 服务端口 ──
PORT=4001

# ── 部署到 /a500/ 子路径时打开 ──
# VITE_BASE_PATH=/a500/
# ATA_COOKIE_PATH=/
